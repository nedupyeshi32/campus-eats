<%- include('partials/header') %>
<section class="menu-page">
  <h1>Menu <%= restaurant.name %></h1>
  <div class="menu-grid">
    <% menuItems.forEach(item => { %>
      <div class="menu-item">
        <h3><%= item.name %></h3>
        <span class="price">Nu. <%= item.price %></span>
      </div>
    <% }); %>
  </div>
</section>
