<%- include('partials/header') %>

<section class="menu-page">
  <h1>Menu</h1>
  <div class="menu-grid">
    <% menuItems.forEach(item => { %>
      <div class="menu-item">
        <h3><%= item.name %></h3>
        <span class="price">Nu. <%= item.price %></span>
        <button class="btn">Add to Order</button>
      </div>
    <% }); %>
  </div>
</section>

<%- include('partials/footer') %>
